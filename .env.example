# Server-side only (never VITE_-prefixed — those get inlined into the client bundle).
# Set these in your host's environment (Vercel dashboard today, your own server after migration).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: when your organization's AI service is connected, point Jiva at it.
# Same contract: POST { messages } -> SSE stream back.
VITE_JIVA_PROXY_URL=